{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ko-ls",
  "version": "0.13.4",
  "identifier": "dev.kols.desktop",
  "build": {
    "frontendDist": "../kols-ui"
  },
  "app": {
    "windows": [
      {
        "label": "workspace",
        "url": "workspace.html",
        "title": "ko-ls",
        "width": 360,
        "height": 760,
        "minWidth": 280,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
